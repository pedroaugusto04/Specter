# ==============================================================================
# Dynamic-Scrapper — Root & Backend Environment Configuration
# Aligned with GitHub Actions Variables (non-sensitive tuning) & Secrets (keys)
# ==============================================================================

# --- Server & Environment ---
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# --- Database & Queue Connections (GitHub Secrets) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dynamic_scrapper
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dynamic_scrapper

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- AI Compiler Provider Configuration ---
# Options: agy | codex
COMPILER_PROVIDER=agy
AGY_CLI_PATH=agy
CODEX_CLI_PATH=codex
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
COMPILER_TEMP_DIR=/tmp/scraper_jobs
COMPILER_TIMEOUT_MS=90000
COMPILER_CONCURRENCY=1

# --- Scraping Engine & VPS Resource Guardrails ---
# Options: playwright | cheerio
SCRAPER_ENGINE=playwright
SCRAPER_CONCURRENCY=3
PLAYWRIGHT_TIMEOUT_MS=30000

# --- Scheduling, Self-Healing & Retention Guardrails ---
MIN_CRON_INTERVAL_MINUTES=15
CONSECUTIVE_FAILURES_FOR_HEALING=2
MAX_HEALING_RETRIES=3
RETENTION_DAYS_UNCHANGED=14

# --- Transactional Notifications (Resend) ---
# Options: resend | console
NOTIFICATION_PROVIDER=console
RESEND_API_KEY=re_placeholder_key
NOTIFICATION_FROM_EMAIL=alerts@scraper.local

# --- Frontend & Deployment ---
NEXT_PUBLIC_BASE_PATH=/scrapper
NEXT_PUBLIC_API_URL=/scrapper/api

# --- VPS Deployment (GitHub Actions Secrets & Variables) ---
# Secrets:
# SERVER_HOST=
# SERVER_USER=
# SERVER_SSH_KEY=<Private SSH Key PEM/RSA content>
# DOCKERHUB_USERNAME=
# DOCKERHUB_TOKEN=<Docker Hub Access Token>
# Variables:
# APP_NAME="Dynamic Scrapper"
# APP_DIR_NAME="dynamic-scrapper"
# FRONTEND_DEPLOY_PATH="/var/www/dynamic-scrapper"
# RELOAD_NGINX="true"
# DOCKER_PLATFORMS="linux/arm64"
