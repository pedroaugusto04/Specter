    {
      "name": "main product excludes recommendations",
      "snapshot": {
        "html": "<main><h1>Chair</h1><b class=\"current\">$100</b></main><aside><h1>Other chair</h1><b class=\"current\">$20</b></aside>",
        "url": "https://example.com/product",
        "httpStatus": 200,
        "responses": []
      },
      "plan": {
        "intent": {
          "entity": "Main product",
          "mode": "single",
          "scope": "page",
          "fields": {
            "title": {
              "description": "Title of main product",
              "type": "string",
              "required": true
            },
            "price": {
              "description": "Current main product price excluding shipping",
              "type": "number",
              "required": true,
              "locale": "en-US"
            }
          },
          "identityFields": [],
          "triggerRules": [],
          "triggerMatchMode": "all"
        },
        "strategy": {
          "transport": "http",
          "records": {
            "kind": "dom",
            "selector": "main"
          },
          "fields": {
            "title": [
              {
                "kind": "dom",
                "selector": "h1",
                "attribute": "text"
              }
            ],
            "price": [
              {
                "kind": "dom",
                "selector": ".current",
                "attribute": "text"
              }
            ]
          },
          "ready": [
            {
              "kind": "exists",
              "locator": {
                "kind": "css",
                "selector": "main"
              }
            }
          ],
          "empty": []
        }
      },
      "expectedRecords": [
        {
          "title": "Chair",
          "price": 100
        }
      ],
      "expectedQuality": "COMPLETE",
      "previousRecords": [
        {
          "title": "Chair",
          "price": 100
        }
      ],
      "expectChange": false
    },
