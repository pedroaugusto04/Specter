    {
      "name": "main product title and price",
      "prompt": "Track the main chair title and current price",
      "snapshot": {
        "html": "<main><h1>Chair</h1><b class=\"current\">$100</b></main><aside><h1>Other chair</h1><b class=\"current\">$20</b></aside>",
        "url": "https://example.com/product",
        "httpStatus": 200,
        "responses": []
      },
      "responses": {
        "intent": {
          "entity": "Main chair",
          "mode": "single",
          "scope": "page",
          "fields": {
            "title": { "description": "Main chair title", "type": "string", "required": true },
            "price": {
              "description": "Current price",
              "type": "number",
              "required": true,
              "locale": "en-US"
            }
          },
          "identityFields": [],
          "filters": [],
          "triggerRules": [],
          "triggerMatchMode": "all"
        },
        "discovery": [{ "action": null }],
        "plan": [
          {
            "transport": "http",
            "records": { "kind": "dom", "selector": "main" },
            "fields": {
              "title": [{ "kind": "dom", "selector": "h1", "attribute": "text" }],
              "price": [{ "kind": "dom", "selector": ".current", "attribute": "text" }]
            },
            "ready": [{ "kind": "exists", "locator": { "kind": "css", "selector": "main" } }],
            "empty": []
          }
        ],
        "semantic": {
          "score": 8,
          "reasons": ["The title and price match the requested main product."],
          "evidenceRefs": ["title", "price"]
        }
      },
      "expectedRecords": [{ "title": "Chair", "price": 100 }],
      "expectedQuality": "COMPLETE",
      "expectedSemanticStatus": "PASSED",
      "previousRecords": [{ "title": "Chair", "price": 100 }],
      "expectChange": false
    },
