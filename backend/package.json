{
  "name": "specter-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:ci": "vitest run --exclude tests/extraction/interactiveExtraction.test.ts",
    "test:heavy": "vitest run tests/extraction/interactiveExtraction.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "node --import tsx node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "evaluate:extraction": "tsx scripts/evaluate-extraction.ts",
    "evaluate:configuration": "node dist/cli/evaluateConfiguration.js",
    "evaluate:regression": "node dist/cli/evaluateRegression.js",
    "test:benchmark": "tsx scripts/run-benchmark.ts",
    "test:live": "tsx scripts/run-live-benchmark.ts",
    "test:live:br": "tsx scripts/run-live-benchmark.ts --tag locale=pt-BR",
    "test:live:global": "tsx scripts/run-live-benchmark.ts --tag locale=en-US",
    "test:live:latam": "tsx scripts/run-live-benchmark.ts --tag locale=es-ES",
    "test:live:news": "tsx scripts/run-live-benchmark.ts --tag siteType=news",
    "test:live:ecommerce": "tsx scripts/run-live-benchmark.ts --tag siteType=ecommerce"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/rate-limit": "^11.2.2",
    "@specter/contracts": "file:../packages/contracts",
    "@supabase/supabase-js": "^2.118.0",
    "bullmq": "^5.81.5",
    "cheerio": "^1.2.0",
    "cron-parser": "^4.9.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "ioredis": "^5.4.2",
    "langfuse": "^3.39.2",
    "playwright": "^1.64.1",
    "postgres": "^3.4.9",
    "resend": "^4.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.9"
  }
}
