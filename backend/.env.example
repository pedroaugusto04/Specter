# ==============================================================================
# Specter Backend Environment Configuration
# ==============================================================================

# --- Server & Environment ---
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
LOG_PRETTY_CONSOLE=true

# --- Database & Queue Connections ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/specter
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# --- AI Compiler Provider (agy | codex | api) ---
COMPILER_PROVIDER=agy
COMPILER_API_MODEL=
COMPILER_API_KEY=
COMPILER_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
COMPILER_API_MAX_RETRIES=3
COMPILER_API_RETRY_BASE_DELAY_MS=1000
COMPILER_API_RETRY_MAX_DELAY_MS=10000
# Allows evaluate:configuration to call the configured model provider. Keep disabled by default.
EVALS_LIVE_MODELS_ENABLED=false
AGY_CLI_PATH=agy
CODEX_CLI_PATH=codex
COMPILER_TEMP_DIR=/tmp/scraper_jobs
COMPILER_TIMEOUT_MS=90000
COMPILER_CONCURRENCY=1

# --- Scraping Engine & Concurrency Limits ---
SCRAPER_ENGINE=playwright
SCRAPER_CONCURRENCY=3
PLAYWRIGHT_TIMEOUT_MS=30000

# --- Anti-Bot Unblockers & Proxies (Optional Fallback Cascade) ---
# When configured, the scraper uses a cascade priority: ZenRows -> ScraperAPI -> ScrapingBee -> Crawlbase -> Local Playwright
# If one runs out of credits (429/402), it automatically falls back to the next!
HTTP_PROXY=
ZENROWS_API_KEY=
SCRAPERAPI_KEY=
SCRAPINGBEE_API_KEY=
CRAWLBASE_TOKEN=

# --- Guardrails & Self-Healing ---
MIN_CRON_INTERVAL_MINUTES=15
CONSECUTIVE_FAILURES_FOR_HEALING=2
MAX_HEALING_RETRIES=3
RETENTION_DAYS_UNCHANGED=14

# --- Notifications (resend | console) ---
NOTIFICATION_PROVIDER=resend
RESEND_API_KEY=re_your_api_key_here
# Resend default sandbox sender: onboarding@resend.dev (delivers to your registered Resend account email)
# In production, verify your domain in Resend (e.g. alerts@yourdomain.com or "Specter Alerts <alerts@yourdomain.com>")
NOTIFICATION_FROM_EMAIL=onboarding@resend.dev
# Optional default Telegram Bot Token (created via @BotFather). Users can also supply their own bot token in Integrations.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Encryption at Rest (AES-256-GCM) ---
# 64-character hex string = 32 bytes key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in all environments: generate with openssl rand -hex 32.
ENCRYPTION_KEY=

# --- Chrome Extension CORS Restriction ---
# In production, set this to your extension's CRX ID to prevent other extensions from calling the API.
# Leave empty in development to allow any chrome-extension:// origin.
# Find your extension ID in chrome://extensions after loading it unpacked.
CHROME_EXTENSION_ID=

# --- Rate Limiting ---
RATE_LIMIT_GLOBAL_MAX=120
RATE_LIMIT_AUTH_MAX=10

# --- Authentication & Stateless JWT Cookies ---
JWT_SECRET=specter-dev-jwt-secret-change-in-production
JWT_ACCESS_EXPIRES_SECONDS=900
JWT_REFRESH_EXPIRES_SECONDS=604800
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# --- Supabase Object Storage (Visual Diff Screenshots) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=specter-screenshots




# Deterministic extraction and compilation budgets
EXTRACTION_MAX_PAGES=10
EXTRACTION_MAX_ACTIONS=20
EXTRACTION_MAX_ITEMS=500
EXTRACTION_TIMEOUT_MS=120000
COMPILATION_BUDGET_MS=300000
# Candidate plan generation attempts inside each compilation job
COMPILATION_MAX_ATTEMPTS=3
# BullMQ retries for transient compilation job failures
COMPILATION_QUEUE_MAX_ATTEMPTS=3
CONFIGURATION_MAX_INPUT_CHARS=250000
# Opt-in detailed model/extraction diagnostics. Logs include redacted prompt evidence and outputs.
COMPILATION_DIAGNOSTICS_ENABLED=false
COMPILATION_DIAGNOSTICS_MAX_CHARS=30000
# Healing attempts use MAX_HEALING_RETRIES within this window
HEALING_WINDOW_MS=86400000

# Modular extraction pipeline (semantic review runs only in setup/recovery)
SEMANTIC_REVIEW_ENABLED=true
SEMANTIC_REVIEW_THRESHOLD=4
EXTRACTION_ACTION_TIMEOUT_MS=10000
EXTRACTION_POLL_INTERVAL_MS=250
EXTRACTION_MAX_EVIDENCE=200
EXTRACTION_EVIDENCE_RETENTION_DAYS=7
# Maximum model decisions per configuration, including invalid output
CONFIGURATION_MAX_DECISIONS=6
# Time reserved for semantic review within the compilation deadline
CONFIGURATION_REVIEW_RESERVE_MS=30000
# Output size ceiling; API token cap also bounds generation
COMPILER_MAX_OUTPUT_CHARS=30000
COMPILER_MAX_OUTPUT_TOKENS=8192
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_TIMEOUT_MS=30000

# Acquisition alternatives and per-monitor access cooldown
ACQUISITION_MAX_ATTEMPTS=3
ACCESS_BLOCK_THRESHOLD=2
ACCESS_BLOCK_COOLDOWN_MINUTES=60
