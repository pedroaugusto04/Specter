# ==============================================================================
# Specter Backend Environment Configuration
# ==============================================================================

# --- Server & Environment ---
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# --- Database & Queue Connections ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/specter
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# --- AI Compiler Provider (agy | codex) ---
COMPILER_PROVIDER=agy
AGY_CLI_PATH=agy
CODEX_CLI_PATH=codex
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
COMPILER_TEMP_DIR=/tmp/scraper_jobs
COMPILER_TIMEOUT_MS=90000
COMPILER_CONCURRENCY=1

# --- Scraping Engine & Concurrency Limits ---
SCRAPER_ENGINE=playwright
SCRAPER_CONCURRENCY=3
PLAYWRIGHT_TIMEOUT_MS=30000

# --- Anti-Bot Unblockers & Proxies (Optional Fallback Cascade) ---
# When configured, the scraper uses a cascade priority: ZenRows -> ScraperAPI -> ScrapingBee -> Crawlbase -> Local Playwright
# If one runs out of credits (429/402), it automatically falls back to the next!
HTTP_PROXY=
ZENROWS_API_KEY=
SCRAPERAPI_KEY=
SCRAPINGBEE_API_KEY=
CRAWLBASE_TOKEN=

# --- Guardrails & Self-Healing ---
MIN_CRON_INTERVAL_MINUTES=15
CONSECUTIVE_FAILURES_FOR_HEALING=2
MAX_HEALING_RETRIES=3
RETENTION_DAYS_UNCHANGED=14

# --- Notifications (resend | console) ---
NOTIFICATION_PROVIDER=resend
RESEND_API_KEY=re_your_api_key_here
# Resend default sandbox sender: onboarding@resend.dev (delivers to your registered Resend account email)
# In production, verify your domain in Resend (e.g. alerts@yourdomain.com or "Specter Alerts <alerts@yourdomain.com>")
NOTIFICATION_FROM_EMAIL=onboarding@resend.dev
# Optional default Telegram Bot Token (created via @BotFather). Users can also supply their own bot token in Integrations.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Authentication & Stateless JWT Cookies ---
JWT_SECRET=specter-dev-jwt-secret-change-in-production
JWT_ACCESS_EXPIRES_SECONDS=900
JWT_REFRESH_EXPIRES_SECONDS=604800
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# --- Supabase Object Storage (Visual Diff Screenshots) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=specter-screenshots



