{
  "manifest_version": 3,
  "name": "Specter Companion — Web Session Sync",
  "version": "1.0.1",
  "description": "Securely sync authenticated web sessions from your browser directly to Specter scraping bots.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": ["cookies", "storage", "tabs"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
